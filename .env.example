# Core Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/larity?schema=public"

# Infrastructure
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://larity:larity_dev@localhost:5672"
RABBITMQ_PREFETCH=10

# Telemetry
# Applications export telemetry to the local collector by default.
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
# Grafana Cloud OTLP endpoint, e.g.:
# https://otlp-gateway-prod-us-east-0.grafana.net/otlp
GRAFANA_CLOUD_OTLP_ENDPOINT=
# Grafana Cloud OTLP basic auth credentials
GRAFANA_CLOUD_USER=
GRAFANA_CLOUD_PASSWORD=

# Apps: Control
FRONTEND_URL="http://localhost:5173"
FRONTEND_URLS="http://localhost:1420,tauri://localhost,http://tauri.localhost"
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apps: Realtime
REALTIME_PORT=9001
REALTIME_WS_URL="ws://127.0.0.1:9001"

# Apps: Desktop
# Used for Tauri development host binding
TAURI_DEV_HOST=
VITE_CONTROL_URL="http://localhost:3000"
VITE_WS_URL="ws://127.0.0.1:9001"

# Object Storage — Cloudflare R2
# Get credentials from your R2 dashboard: https://dash.cloudflare.com/?to=/:account/r2
# Region is always "auto" for R2.
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_AUDIO_BUCKET="larity-audio"

# Apps: Workers
WORKERS_PORT=8080
# Worker Queue[Redis] — reuses the same Redis instance
# REDIS_URL is defined above

# Apps: Admin
# Bearer token for admin endpoints (audio recovery, etc.)
ADMIN_API_KEY=

# Packages: STT (Speech-to-Text)
DEEPGRAM_API_KEY=
MAX_CONNECTIONS=50

# Packages: Meeting Mode
# Legacy: maps to MERGE_GROUPING_MS when MERGE_GROUPING_MS unset
MERGE_GAP_MS=5000
MERGE_GROUPING_MS=5000
MERGE_PUBLISH_GAP_MS=700
LEDGER_SNAPSHOT_DEBOUNCE_MS=400
COST_CAP_CACHE_TTL_MS=500
MAX_BUFFER_SIZE=20
GEMINI_API_KEY=
SAMBANOVA_API_KEY=
# Optional override (default gpt-oss-120b)
# SAMBANOVA_TIER2_MODEL=
