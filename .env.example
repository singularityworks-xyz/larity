# Core Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:54321/larity?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="larity"

# Infrastructure
REDIS_URL="redis://localhost:56379"

# Apps: Control
FRONTEND_URL="http://localhost:5173"
FRONTEND_URLS="http://localhost:1420,tauri://localhost,http://tauri.localhost"
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=uT0De1N38fuHtkY/Uinh1DHADlyyCLrFMAPgiHtEjKs=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apps: Realtime
REALTIME_PORT=9001
REALTIME_WS_URL="ws://127.0.0.1:9001"

# Apps: Desktop
# Used for Tauri development host binding
TAURI_DEV_HOST=
VITE_CONTROL_URL="http://localhost:3000"
VITE_WS_URL="ws://127.0.0.1:9001"

# Object Storage — Local RustFS (Development) / Cloudflare R2 (Production)
# Defaults configured for local RustFS running in docker-compose
S3_ENDPOINT="http://localhost:59000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="larityadmin"
S3_SECRET_ACCESS_KEY="laritysecret"
S3_AUDIO_BUCKET="larity-audio"

# Apps: Workers
WORKERS_PORT=8080
# Worker Queue[Redis] — reuses the same Redis instance
# REDIS_URL is defined above

# Apps: Admin
# Bearer token for admin endpoints (audio recovery, etc.)
ADMIN_API_KEY=

# Packages: STT (Speech-to-Text)
DEEPGRAM_API_KEY=
MAX_CONNECTIONS=50
# Deepgram tuning knobs (P5.7 defaults are LOCKED — see docs/VAD.md; uncomment to override)
# DEEPGRAM_ENDPOINTING_MS=450
# DEEPGRAM_UTTERANCE_END_MS=1000
# DEEPGRAM_NO_DELAY=false
# DEEPGRAM_DIARIZE_MIC=true

# Packages: Meeting Mode
# Legacy: maps to MERGE_GROUPING_MS when MERGE_GROUPING_MS unset
MERGE_GAP_MS=5000
MERGE_GROUPING_MS=5000
MERGE_PUBLISH_GAP_MS=250
LEDGER_SNAPSHOT_DEBOUNCE_MS=400
COST_CAP_CACHE_TTL_MS=500
GEMINI_API_KEY=
# GEMINI_TIER4_MODEL=gemini-3.5-flash-lite
# General Compute — Tier 2 classifier (OpenAI-compatible)
GENERALCOMPUTE_API_KEY=
# Optional overrides (base URL defaults to https://api.generalcompute.com/v1,
# model to gpt-oss-120b, timeout to 3000ms)
# GENERALCOMPUTE_BASE_URL=
# GENERALCOMPUTE_TIER2_MODEL=
# GENERALCOMPUTE_TIER2_TIMEOUT_MS=
# Optional Tier 2 test-time compute (none|minimal|low|medium|high|xhigh; default low)
# TIER2_REASONING_EFFORT=
# Speculative processing: OFF by default (NO-GO per docs/SPECULATIVE_PROCESSING.md).
# Enable only after the P3.6 hit-rate rule is measured on dogfood data.
# SPECULATIVE_ENABLED=false
