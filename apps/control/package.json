    "start": "NODE_ENV=production bun dist/index.js"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.1",
    "@elysiajs/cron": "^1.4.2",
    "@elysiajs/opentelemetry": "^1.4.10",
    "@larity/infra": "workspace:*",
    "@larity/jobs": "workspace:*",
    "@larity/logger": "workspace:*",
    "@larity/telemetry": "workspace:*",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.212.0",
    "@opentelemetry/sdk-trace-node": "^2.5.1",
    "better-auth": "^1.4.10",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.21",
    "ioredis": "^5.9.2",
    "meeting-mode": "workspace:*",
    "prom-client": "^15.1.3",
    "resend": "^6.14.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.1-rc"
