{
  "name": "@larity/control",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist --external @prisma/client --external better-auth",
    "check-types": "tsc --noEmit",
    "start": "NODE_ENV=production bun dist/index.js"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/cron": "^1.4.2",
    "@larity/db": "workspace:*",
    "@larity/infra": "workspace:*",
    "@larity/jobs": "workspace:*",
    "@larity/logger": "workspace:*",
    "better-auth": "^1.6.22",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.29",
    "ioredis": "^5.11.1",
    "meeting-mode": "workspace:*",
    "resend": "^6.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "typescript": "^7.0.1-rc"
  },
  "version": "0.0.6"
}
