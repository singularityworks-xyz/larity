# Desktop app environment (Vite)
# Local development defaults — see root .env.example for full backend config.
# Production endpoints are injected by CI via GitHub Secrets at build time
# (VITE_CONTROL_URL / VITE_WS_URL). These values are REQUIRED for `tauri build`
# and `vite build` in production mode.

# REST control plane (better-auth + API)
VITE_CONTROL_URL=http://localhost:3000

# Realtime WebSocket plane (audio + VAD signals)
VITE_WS_URL=ws://127.0.0.1:9001
