{
  "name": "larity",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.1.34",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:root": "biome check --log-level=info --diagnostic-level=warn .",
    "lint:fix": "turbo run lint:fix && bun run lint:root --write",
    "format": "turbo run format && biome format --write .",
    "format:check": "turbo run format:check && biome format .",
    "check": "ultracite check",
    "test": "find packages apps -name '*.test.ts' ! -name '*.integration.test.ts' ! -name '*.e2e.test.ts' -not -path '*/node_modules/*' -type f | xargs bun test",
    "test:integration": "find packages apps -name '*.integration.test.ts' -not -path '*/node_modules/*' -type f | xargs bun test",
    "smoke:telemetry": "bash scripts/telemetry-smoke.sh",
    "prepare": "husky",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@types/amqplib": "^0.10.8",
    "@types/bun": "latest",
    "@types/ioredis-mock": "^8.2.7",
    "husky": "^9.1.7",
    "ioredis-mock": "^8.13.1",
    "prisma": "^7.2.0",
    "turbo": "^2.6.3",
    "ultracite": "7.1.4"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "amqplib": "^0.10.9",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3"
  }
}
