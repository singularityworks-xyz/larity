{
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "lefthook": "^2.1.9",
    "lint-staged": "^17.0.8",
    "turbo": "^2.10.0",
    "typescript": "^7.0.1-rc",
    "ultracite": "7.8.3"
  },
  "name": "larity",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "deps": "bunx taze -wr && bunx sherif@latest --fix",
    "mock": "cd apps/mock && bun run mock",
    "build": "turbo run build",
    "check-types": "turbo run check-types && make rust-clippy",
    "check": "ultracite fix --unsafe && make rust-fix",
    "test": "turbo run test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:gen": "turbo run generate --filter=@larity/db",
    "db:push": "turbo run push --filter=@larity/db",
    "db:migrate": "turbo run migrate --filter=@larity/db",
    "db:studio": "turbo run studio --filter=@larity/db",
    "setup": "cp -n .env.example .env 2>/dev/null || true && bun install && bun docker:up && bun db:generate && bun db:push"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true,
  "packageManager": "bun@1.3.14",
  "overrides": {
    "brace-expansion": "^5.0.7",
    "deepmerge-ts": "^8.0.0",
    "fast-uri": "^4.1.2"
  },
  "patchedDependencies": {
    "@deepgram/sdk@5.4.0": "patches/@deepgram%2Fsdk@5.4.0.patch"
  },
  "version": "0.1.12"
}
