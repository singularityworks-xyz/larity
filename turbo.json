{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "build/**", "out/**"],
      "cache": true
    },
    "check-types": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "check": {
      "dependsOn": ["check-types"],
      "cache": true
    },
    "generate": {
      "cache": false
    },
    "push": {
      "cache": false
    },
    "migrate": {
      "cache": false
    }
  }
}
